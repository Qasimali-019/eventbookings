# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas (or local)
MONGODB_URI=mongodb://localhost:27017/eventcraft

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Optional: Redis (cache + queue + pub/sub)
# REDIS_URL=redis://localhost:6379

# Optional: Email (SendGrid / Resend)
# SENDGRID_API_KEY=
# RESEND_API_KEY=

# Optional: SMS (Twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
